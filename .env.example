PORT=4000
# Supabase: transaction-mode pooler (used by app at runtime)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/portfolio
# Supabase: session-mode pooler (used by prisma migrate deploy)
DIRECT_URL=postgresql://postgres:yourpassword@localhost:5432/portfolio
OWNER_USERNAME=admin
# bcrypt hash of the owner password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list — add your Vercel URL when deployed
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops in front of this server (0 = direct).
# Set to 1 when behind Cloudflare Tunnel / a single reverse proxy, or per-IP
# rate limiting will key on the proxy's IP instead of the client's.
TRUST_PROXY_HOPS=0
